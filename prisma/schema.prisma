generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  title       String
  location    String
  email       String
  phone       String?
  summary     String   @db.Text
  linkedinUrl String?
  githubUrl   String?
  websiteUrl  String?
  resumeUrl   String?
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model SkillGroup {
  id        String   @id @default(cuid())
  label     String
  order     Int
  skills    Skill[]
  updatedAt DateTime @default(now()) @updatedAt
}

model Skill {
  id        String     @id @default(cuid())
  name      String
  groupId   String
  group     SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order     Int
  updatedAt DateTime   @default(now()) @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  companyNote String?
  startDate   DateTime
  endDate     DateTime?
  bullets     String[]
  order       Int
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String[]
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  featured    Boolean  @default(false)
  order       Int
  updatedAt   DateTime @default(now()) @updatedAt
}

model Certification {
  id        String   @id @default(cuid())
  name      String
  issuer    String?
  url       String?
  order     Int
  updatedAt DateTime @default(now()) @updatedAt
}

model Education {
  id          String    @id @default(cuid())
  degree      String
  institution String
  detail      String?
  startDate   DateTime
  endDate     DateTime?
  order       Int
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

model AdminUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(true)
  image         String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String    @id
  expiresAt DateTime
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
