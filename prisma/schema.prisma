generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  title       String
  location    String
  email       String
  phone       String?
  summary     String   @db.Text
  linkedinUrl String?
  githubUrl   String?
  websiteUrl  String?
  resumeUrl   String?
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model SkillGroup {
  id     String  @id @default(cuid())
  label  String
  order  Int
  skills Skill[]
}

model Skill {
  id      String     @id @default(cuid())
  name    String
  groupId String
  group   SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order   Int
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  companyNote String?
  startDate   DateTime
  endDate     DateTime?
  bullets     String[]
  order       Int
}

model Project {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String[]
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  featured    Boolean  @default(false)
  order       Int
}

model Certification {
  id     String  @id @default(cuid())
  name   String
  issuer String?
  url    String?
  order  Int
}

model Education {
  id          String    @id @default(cuid())
  degree      String
  institution String
  detail      String?
  startDate   DateTime
  endDate     DateTime?
  order       Int
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
