DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Optional. On Vercel the live domain is used automatically.
# SITE_URL="https://your-domain.com"

# Contact form mail. Messages are always saved in Admin → Messages.
# Without these, nothing is emailed.
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify a domain, then set RESEND_FROM to an address on that domain.
#    The default onboarding@resend.dev address can only deliver to the
#    email address on your Resend account.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Portfolio <you@your-domain.com>"
# CONTACT_TO_EMAIL="you@example.com"

# File uploads: S3, Cloudinary, or local public/uploads (dev fallback).
# S3_BUCKET="your-bucket"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://your-bucket.s3.ap-south-1.amazonaws.com"
# S3_ENDPOINT=""

# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

